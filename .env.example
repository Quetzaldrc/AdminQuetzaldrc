# Copie ce fichier en ".env" et adapte les valeurs si besoin.
# Ces valeurs sont injectées au moment du "build" (git push → GitHub Actions).

# URL de ton Google Apps Script (se termine par /exec)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwppp-AYKpPL5WRuU1hUtg-ymOFLnCWhGE-y0mGUdNouxJbHpv9RbIKwRbMUhf1ynEM/exec

# Mot de passe d'accès au site admin (protection simple, pas une vraie sécurité)
VITE_ADMIN_PASSWORD=change-moi
